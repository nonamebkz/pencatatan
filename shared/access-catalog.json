{
  "version": 1,
  "sections": [
    {
      "id": "main",
      "label": "Menu utama",
      "menu": [
        {
          "id": "nav.dashboard",
          "label": "Beranda",
          "description": "Ringkasan harian",
          "path": "/",
          "icon": "LayoutDashboard",
          "end": true
        },
        {
          "id": "nav.finance",
          "label": "Keuangan",
          "description": "Pembelian & pengeluaran",
          "path": "/finance",
          "icon": "Wallet",
          "pages": [
            {
              "id": "page.finance.home",
              "label": "Ringkasan keuangan",
              "path": "/finance",
              "actions": [
                {
                  "id": "read",
                  "label": "Akses menu keuangan",
                  "permission": "finance.read",
                  "resource": "finance",
                  "action": "read",
                  "description": "Lihat ringkasan & daftar transaksi",
                  "routes": ["/finance"],
                  "operatorDefault": true
                }
              ]
            },
            {
              "id": "page.finance.reports",
              "label": "Laporan keuangan",
              "path": "/finance/reports",
              "actions": [
                {
                  "id": "read",
                  "label": "Lihat laporan operasional",
                  "permission": "finance.read",
                  "resource": "finance",
                  "action": "reports",
                  "description": "RPT-01, 02, 06 dan hub laporan",
                  "routes": [
                    "/finance/reports",
                    "/finance/reports/purchases",
                    "/finance/reports/price-history",
                    "/finance/reports/summary"
                  ],
                  "operatorDefault": true
                }
              ]
            },
            {
              "id": "page.finance.purchases",
              "label": "Pembelian",
              "path": "/finance/purchases",
              "actions": [
                {
                  "id": "create",
                  "label": "Catat pembelian",
                  "permission": "finance.purchase.create",
                  "resource": "finance",
                  "action": "purchase",
                  "description": "Form pembelian multi-item",
                  "routes": ["/finance/purchases/new"],
                  "operatorDefault": true
                }
              ]
            },
            {
              "id": "page.finance.expenses",
              "label": "Pengeluaran lain",
              "path": "/finance/expenses",
              "actions": [
                {
                  "id": "create",
                  "label": "Catat pengeluaran lain",
                  "permission": "finance.expense.create",
                  "resource": "finance",
                  "action": "expense",
                  "description": "Form pengeluaran operasional",
                  "routes": ["/finance/expenses/new"],
                  "operatorDefault": true
                }
              ]
            },
            {
              "id": "page.finance.rent",
              "label": "Sewa kolam",
              "path": "/finance/rent",
              "actions": [
                {
                  "id": "read",
                  "label": "Lihat kontrak sewa",
                  "permission": "finance.rent.read",
                  "resource": "finance",
                  "action": "rent_read",
                  "description": "Daftar & detail kontrak sewa kolam",
                  "routes": ["/finance/rent", "/finance/rent/:id"],
                  "operatorDefault": true
                },
                {
                  "id": "create",
                  "label": "Buat kontrak sewa",
                  "permission": "finance.rent.create",
                  "resource": "finance",
                  "action": "rent_create",
                  "description": "Form kontrak sewa & jadwal cicilan",
                  "routes": ["/finance/rent/new"],
                  "operatorDefault": true
                },
                {
                  "id": "pay",
                  "label": "Bayar jadwal sewa",
                  "permission": "finance.rent.pay",
                  "resource": "finance",
                  "action": "rent_pay",
                  "description": "Catat pembayaran per jadwal → RENT_PAYMENT",
                  "routes": ["/finance/rent/:id"],
                  "operatorDefault": true
                }
              ]
            },
            {
              "id": "page.finance.cash_accounts",
              "label": "Akun kas",
              "path": "/finance/cash-accounts",
              "actions": [
                {
                  "id": "read",
                  "label": "Lihat daftar & pilih di form",
                  "permission": "cash_account.read",
                  "resource": "cash_account",
                  "action": "read",
                  "description": "Halaman akun kas & daftar kas di pembelian/pengeluaran",
                  "routes": ["/finance/cash-accounts"],
                  "operatorDefault": true
                },
                {
                  "id": "create",
                  "label": "Tambah akun kas",
                  "permission": "cash_account.create",
                  "resource": "cash_account",
                  "action": "create",
                  "description": "Form tambah kas",
                  "routes": ["/finance/cash-accounts/new"],
                  "operatorDefault": true
                },
                {
                  "id": "update",
                  "label": "Ubah akun kas",
                  "permission": "cash_account.update",
                  "resource": "cash_account",
                  "action": "update",
                  "description": "Form edit kas & jadikan default",
                  "routes": ["/finance/cash-accounts/:id/edit"],
                  "operatorDefault": true
                },
                {
                  "id": "delete",
                  "label": "Hapus akun kas",
                  "permission": "cash_account.delete",
                  "resource": "cash_account",
                  "action": "delete",
                  "description": "Tombol hapus di form edit kas"
                }
              ]
            }
          ]
        },
        {
          "id": "nav.ponds",
          "label": "Kolam",
          "description": "Master kolam",
          "path": "/ponds",
          "icon": "Fish",
          "pages": [
            {
              "id": "page.ponds.list",
              "label": "Daftar kolam",
              "path": "/ponds",
              "actions": [
                {
                  "id": "read",
                  "label": "Lihat daftar kolam",
                  "permission": "pond.read",
                  "resource": "pond",
                  "action": "read",
                  "description": "Menu kolam & daftar master",
                  "routes": ["/ponds"],
                  "operatorDefault": true
                }
              ]
            },
            {
              "id": "page.ponds.form",
              "label": "Tambah / ubah kolam",
              "path": "/ponds",
              "actions": [
                {
                  "id": "create",
                  "label": "Tambah kolam",
                  "permission": "pond.create",
                  "resource": "pond",
                  "action": "create",
                  "description": "Form tambah kolam",
                  "routes": ["/ponds/new"],
                  "operatorDefault": true
                },
                {
                  "id": "update",
                  "label": "Ubah kolam",
                  "permission": "pond.update",
                  "resource": "pond",
                  "action": "update",
                  "description": "Form edit kolam",
                  "routes": ["/ponds/:id/edit"],
                  "operatorDefault": true
                }
              ]
            },
            {
              "id": "page.ponds.detail",
              "label": "Detail kolam",
              "path": "/ponds/:id",
              "actions": [
                {
                  "id": "delete",
                  "label": "Hapus kolam",
                  "permission": "pond.delete",
                  "resource": "pond",
                  "action": "delete",
                  "description": "Hapus master kolam dari UI"
                }
              ]
            }
          ]
        },
        {
          "id": "nav.water_quality",
          "label": "Kualitas Air",
          "description": "Catatan observasi",
          "path": "/water-quality",
          "icon": "Droplets",
          "pages": [
            {
              "id": "page.water_quality.list",
              "label": "Daftar catatan",
              "path": "/water-quality",
              "actions": [
                {
                  "id": "read",
                  "label": "Lihat catatan kualitas air",
                  "permission": "water_quality.read",
                  "resource": "water_quality",
                  "action": "read",
                  "description": "Menu & daftar observasi",
                  "routes": ["/water-quality"],
                  "operatorDefault": true
                }
              ]
            },
            {
              "id": "page.water_quality.report",
              "label": "Laporan",
              "path": "/water-quality/report",
              "actions": [
                {
                  "id": "read",
                  "label": "Laporan tren",
                  "permission": "water_quality.read",
                  "resource": "water_quality",
                  "action": "read",
                  "description": "Halaman laporan grafik",
                  "routes": ["/water-quality/report"],
                  "operatorDefault": true
                }
              ]
            },
            {
              "id": "page.water_quality.form",
              "label": "Catat / ubah observasi",
              "path": "/water-quality",
              "actions": [
                {
                  "id": "create",
                  "label": "Catat observasi",
                  "permission": "water_quality.create",
                  "resource": "water_quality",
                  "action": "create",
                  "description": "Form catat & FAB catat cepat",
                  "routes": ["/water-quality/new"],
                  "operatorDefault": true
                },
                {
                  "id": "update",
                  "label": "Ubah observasi",
                  "permission": "water_quality.update",
                  "resource": "water_quality",
                  "action": "update",
                  "description": "Form edit catatan",
                  "routes": ["/water-quality/:id/edit"],
                  "operatorDefault": true
                },
                {
                  "id": "delete",
                  "label": "Hapus catatan",
                  "permission": "water_quality.delete",
                  "resource": "water_quality",
                  "action": "delete",
                  "description": "Hapus log kualitas air"
                }
              ]
            },
            {
              "id": "page.water_quality.config",
              "label": "Konfigurasi ambang",
              "path": "/settings/water-quality",
              "actions": [
                {
                  "id": "update_config",
                  "label": "Ubah template ambang",
                  "permission": "water_quality.config.update",
                  "resource": "water_quality",
                  "action": "config",
                  "description": "Halaman pengaturan kualitas air workspace",
                  "routes": ["/settings/water-quality"]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "access",
      "label": "Kelola Akses",
      "menu": [
        {
          "id": "nav.users",
          "label": "Pengguna",
          "description": "Kelola akun tim",
          "path": "/users",
          "icon": "UserCog",
          "menuPermission": "user.read",
          "pages": [
            {
              "id": "page.users.list",
              "label": "Daftar pengguna",
              "path": "/users",
              "actions": [
                {
                  "id": "read",
                  "label": "Lihat daftar & detail",
                  "permission": "user.read",
                  "resource": "user",
                  "action": "read",
                  "description": "Menu pengguna & halaman daftar",
                  "routes": ["/users", "/users/:id/edit"]
                },
                {
                  "id": "create",
                  "label": "Tambah pengguna",
                  "permission": "user.create",
                  "resource": "user",
                  "action": "create",
                  "description": "Form tambah pengguna",
                  "routes": ["/users/new"]
                },
                {
                  "id": "update",
                  "label": "Ubah profil & reset password",
                  "permission": "user.update",
                  "resource": "user",
                  "action": "update",
                  "description": "Form edit pengguna"
                },
                {
                  "id": "delete",
                  "label": "Hapus pengguna",
                  "permission": "user.delete",
                  "resource": "user",
                  "action": "delete",
                  "description": "Hapus akun tim"
                },
                {
                  "id": "assign_role",
                  "label": "Atur peran pengguna",
                  "permission": "user.assign_role",
                  "resource": "user",
                  "action": "assign_role",
                  "description": "Pilih role RBAC di form pengguna"
                }
              ]
            }
          ]
        },
        {
          "id": "nav.roles",
          "label": "Peran",
          "description": "Paket permission",
          "path": "/roles",
          "icon": "Shield",
          "menuPermission": "role.read",
          "pages": [
            {
              "id": "page.roles.list",
              "label": "Daftar peran",
              "path": "/roles",
              "actions": [
                {
                  "id": "read",
                  "label": "Lihat daftar & detail peran",
                  "permission": "role.read",
                  "resource": "role",
                  "action": "read",
                  "description": "Menu peran & form edit metadata",
                  "routes": ["/roles", "/roles/:id/edit"]
                },
                {
                  "id": "create",
                  "label": "Buat peran custom",
                  "permission": "role.create",
                  "resource": "role",
                  "action": "create",
                  "description": "Form tambah peran",
                  "routes": ["/roles/new"]
                },
                {
                  "id": "update",
                  "label": "Ubah nama & deskripsi peran",
                  "permission": "role.update",
                  "resource": "role",
                  "action": "update",
                  "description": "Simpan profil peran"
                },
                {
                  "id": "delete",
                  "label": "Hapus peran custom",
                  "permission": "role.delete",
                  "resource": "role",
                  "action": "delete",
                  "description": "Hapus peran non-sistem"
                },
                {
                  "id": "assign_permission",
                  "label": "Centang permission peran",
                  "permission": "role.assign_permission",
                  "resource": "role",
                  "action": "assign_permission",
                  "description": "Simpan checkbox permission di form peran"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "metaPermissions": [
    {
      "id": "meta.permission.read",
      "label": "Baca katalog permission (API)",
      "permission": "permission.read",
      "resource": "permission",
      "action": "read",
      "description": "Endpoint GET /permissions (juga via akses kelola peran)"
    },
    {
      "id": "meta.audit.read",
      "label": "Baca log audit",
      "permission": "audit.read",
      "resource": "audit",
      "action": "read",
      "description": "Log audit akses (fase berikutnya)"
    }
  ],
  "roleDefaults": {
    "workspaceAdmin": "all",
    "operatorPermissionCodes": [
      "finance.read",
      "finance.purchase.create",
      "finance.expense.create",
      "finance.rent.read",
      "finance.rent.create",
      "finance.rent.pay",
      "cash_account.read",
      "cash_account.create",
      "cash_account.update",
      "pond.read",
      "pond.create",
      "pond.update",
      "water_quality.read",
      "water_quality.create",
      "water_quality.update"
    ]
  }
}
