# ─── Port (semua bisa di-overwrite) ───
MYSQL_PORT=3306
APP_PORT=8080
FRONTEND_PORT=3000
FRONTEND_CONTAINER_PORT=80
FRONTEND_DEV_PORT=5173

# Port internal MySQL di jaringan Docker (jarang diubah)
DB_INTERNAL_PORT=3306

# ─── Backend ───
APP_ENV=development

DB_HOST=mysql
DB_PORT=3306
DB_USER=pencatatan
DB_PASSWORD=pencatatan
DB_NAME=pencatatan
DB_ROOT_PASSWORD=root

# Origin frontend yang boleh akses API (wajib sesuaikan di production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth (JWT)
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRY=24h
ADMIN_EMAIL=admin@pencatatan.local
ADMIN_PASSWORD=changeme123

# ─── Frontend ───
# URL backend penuh (browser call langsung, tanpa nginx proxy)
VITE_API_BASE=http://localhost:8080/api/v1

# Production example:
# VITE_API_BASE=https://pencatatan.rubyjane.my.id:8801/api/v1
# CORS_ORIGINS=https://pencatatan.rubyjane.my.id
