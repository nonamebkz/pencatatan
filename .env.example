# ─── Port (semua bisa di-overwrite) ───
MYSQL_PORT=3306
APP_PORT=8080
FRONTEND_PORT=3000
FRONTEND_CONTAINER_PORT=80
FRONTEND_DEV_PORT=5173

# Port internal MySQL di jaringan Docker (jarang diubah)
DB_INTERNAL_PORT=3306

# ─── Backend ───
APP_ENV=development

DB_HOST=mysql
DB_PORT=3306
DB_USER=pencatatan
DB_PASSWORD=pencatatan
DB_NAME=pencatatan
DB_ROOT_PASSWORD=root

# Sesuaikan jika MYSQL_PORT / FRONTEND_PORT / FRONTEND_DEV_PORT diubah
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Frontend ───
VITE_API_BASE=/api
# Dev lokal: target proxy ke backend (default http://localhost:${APP_PORT})
# VITE_PROXY_TARGET=http://localhost:8080
