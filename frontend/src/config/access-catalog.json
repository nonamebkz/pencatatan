        {
          "id": "nav.dashboard",
          "label": "Beranda",
          "description": "Ringkasan harian",
          "path": "/",
          "icon": "LayoutDashboard",
          "end": true
        },
        {
          "id": "nav.finance",
          "label": "Keuangan",
          "description": "Pembelian & pengeluaran",
          "path": "/finance",
          "icon": "Wallet",
          "pages": [
            {
              "id": "page.finance.home",
              "label": "Ringkasan keuangan",
              "path": "/finance",
              "actions": []
            },
            {
              "id": "page.finance.purchases",
              "label": "Pembelian",
              "path": "/finance/purchases",
              "actions": []
            },
            {
              "id": "page.finance.expenses",
              "label": "Pengeluaran lain",
              "path": "/finance/expenses",
              "actions": []
            },
            {
              "id": "page.finance.cash_accounts",
              "label": "Akun kas",
              "path": "/finance/cash-accounts",
              "actions": [
                {
                  "id": "read",
                  "label": "Lihat daftar & pilih di form",
                  "permission": "cash_account.read",
                  "resource": "cash_account",
                  "action": "read",
                  "description": "Halaman akun kas & daftar kas di pembelian/pengeluaran",
                  "routes": ["/finance/cash-accounts"],
                  "operatorDefault": true
                },
                {
                  "id": "create",
                  "label": "Tambah akun kas",
                  "permission": "cash_account.create",
                  "resource": "cash_account",
                  "action": "create",
                  "description": "Form tambah kas",
                  "routes": ["/finance/cash-accounts/new"],
                  "operatorDefault": true
                },
                {
                  "id": "update",
                  "label": "Ubah akun kas",
                  "permission": "cash_account.update",
                  "resource": "cash_account",
                  "action": "update",
                  "description": "Form edit kas & jadikan default",
                  "routes": ["/finance/cash-accounts/:id/edit"],
                  "operatorDefault": true
                },
                {
                  "id": "delete",
                  "label": "Hapus akun kas",
                  "permission": "cash_account.delete",
                  "resource": "cash_account",
                  "action": "delete",
                  "description": "Tombol hapus di form edit kas"
                }
              ]
            }
          ]
        },
        {
          "id": "nav.ponds",
